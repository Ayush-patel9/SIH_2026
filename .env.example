# Google Gemini API Keys Configuration
# Get free API keys from: https://aistudio.google.com/

# Option 1: Multiple keys in rotation pool (comma-separated) - RECOMMENDED for hackathons & demos
GEMINI_API_KEYS=your_gemini_api_key_1,your_gemini_api_key_2,your_gemini_api_key_3

# Option 2: Single key
# GEMINI_API_KEY=your_gemini_api_key_here

# Model Selection (Defaults to gemini-2.5-flash and gemini-2.5-pro)
GEMINI_FLASH_MODEL=gemini-2.5-flash
GEMINI_PRO_MODEL=gemini-2.5-pro
