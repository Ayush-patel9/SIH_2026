# ==============================================================
# BIS Standards Intelligence Platform — Environment Configuration
# Copy this file to .env and fill in your actual API credentials.
# ==============================================================

# --------------------------------------------------------------
# 1. Google Gemini API Keys Configuration
# Get free API keys from: https://aistudio.google.com/
# --------------------------------------------------------------
# Option 1: Multiple keys in rotation pool (comma-separated) - RECOMMENDED
GEMINI_API_KEYS=your_gemini_api_key_1,your_gemini_api_key_2

# Option 2: Single key fallback
# GEMINI_API_KEY=your_gemini_api_key_here

# Model Selection
GEMINI_FLASH_MODEL=gemini-3.8-flash
GEMINI_PRO_MODEL=gemini-3.8-flash

# --------------------------------------------------------------
# 2. Cloudinary Configuration (PDF Storage & Document Viewer)
# Get credentials from: https://cloudinary.com/console
# Used to securely store and view tender PDFs in the embedded viewer.
# If omitted, uploaded tender documents are cached locally in data/tenders/.
# --------------------------------------------------------------
CLOUDINARY_CLOUD_NAME=your_cloudinary_cloud_name
CLOUDINARY_API_KEY=your_cloudinary_api_key
CLOUDINARY_API_SECRET=your_cloudinary_api_secret

# --------------------------------------------------------------
# 3. Database Configuration (Optional - Neon PostgreSQL)
# Used for persistent project workspaces, procurement ledgers, and audit logs.
# If omitted, runs in offline/in-memory session mode.
# --------------------------------------------------------------
# DATABASE_URL=postgresql://user:password@ep-sample-pool.region.aws.neon.tech/neondb?sslmode=require

# --------------------------------------------------------------
# 4. Frontend Configuration (Optional)
# --------------------------------------------------------------
# VITE_API_BASE=http://localhost:8000
