{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "title": "SIH2026_BIS_Standards_Intelligence_Contracts",
  "description": "Canonical API schemas for SIH 2026 BIS Standards Intelligence Platform",
  "definitions": {
    "QueryRequest": {
      "$id": "SIH2026.QueryRequest.v1",
      "type": "object",
      "required": ["query_id", "session_id", "timestamp", "input"],
      "properties": {
        "query_id": { "type": "string" },
        "session_id": { "type": "string" },
        "timestamp": { "type": "string", "format": "date-time" },
        "auth": {
          "type": "object",
          "properties": {
            "role": { "type": "string", "enum": ["PROCUREMENT_OFFICER", "AUDITOR", "VENDOR", "BIS_EXPERT"] },
            "user_id": { "type": "string" },
            "ministry_code": { "type": "string" }
          }
        },
        "input": {
          "type": "object",
          "required": ["text"],
          "properties": {
            "text": { "type": "string" },
            "language": { "type": "string", "enum": ["en", "hi", "ta", "te", "gu", "mr", "bn"] },
            "source": { "type": "string", "enum": ["direct_query", "tender_upload", "gem_integration", "cppp_integration"] },
            "mode": { "type": "string", "enum": ["recommend", "audit", "dry_run", "vendor_check"] }
          }
        },
        "context": {
          "type": "object",
          "properties": {
            "product_category": { "type": "string" },
            "known_standards": { "type": "array", "items": { "type": "string" } },
            "procurement_value_inr": { "type": "number" },
            "project_type": { "type": "string" }
          }
        },
        "preferences": {
          "type": "object",
          "properties": {
            "explain_mode": { "type": "string", "enum": ["VERBOSE", "COMPACT", "PLAIN_LANGUAGE"] },
            "include_graph_path": { "type": "boolean" },
            "include_allied_standards": { "type": "boolean" },
            "max_results": { "type": "integer" }
          }
        }
      }
    },
    "StandardsResponse": {
      "$id": "SIH2026.StandardsResponse.v1",
      "type": "object",
      "required": [
        "meta",
        "query_understanding",
        "primary_recommendation",
        "allied_standards",
        "outdated_citations",
        "graph_path",
        "reasoning_trace",
        "plain_language_explanation",
        "compliance_checklist",
        "audit_record",
        "staleness_risk",
        "multilingual"
      ],
      "properties": {
        "$schema": { "type": "string" },
        "meta": {
          "type": "object",
          "required": ["query_id", "session_id", "timestamp", "processing_time_ms", "pipeline_version", "audit_reference_hash", "mode"],
          "properties": {
            "query_id": { "type": "string" },
            "session_id": { "type": "string" },
            "timestamp": { "type": "string", "format": "date-time" },
            "processing_time_ms": { "type": "number" },
            "pipeline_version": { "type": "string" },
            "model_version": { "type": "string" },
            "data_snapshot_date": { "type": "string" },
            "audit_reference_hash": { "type": "string" },
            "mode": { "type": "string", "enum": ["recommend", "audit", "dry_run", "vendor_check"] }
          }
        },
        "query_understanding": {
          "type": "object",
          "required": ["detected_language", "original_text", "normalized_text", "extracted_entities", "query_intent"],
          "properties": {
            "detected_language": { "type": "string" },
            "original_text": { "type": "string" },
            "normalized_text": { "type": "string" },
            "extracted_entities": {
              "type": "array",
              "items": {
                "type": "object",
                "required": ["entity", "type", "confidence"],
                "properties": {
                  "entity": { "type": "string" },
                  "type": { "type": "string", "enum": ["PRODUCT", "GRADE_SPECIFICATION", "APPLICATION_DOMAIN", "TEST_PARAMETER"] },
                  "confidence": { "type": "number", "minimum": 0, "maximum": 1 }
                }
              }
            },
            "query_intent": { "type": "string", "enum": ["STANDARD_LOOKUP", "COMPLIANCE_CHECK", "ALLIED_DISCOVERY", "OUTDATED_DETECTION"] }
          }
        },
        "primary_recommendation": {
          "type": "object",
          "required": ["is_number", "title", "status", "confidence", "certification"],
          "properties": {
            "is_number": { "type": "string" },
            "standard_id": { "type": "string" },
            "title": { "type": "string" },
            "full_title": { "type": "string" },
            "status": { "type": "string", "enum": ["ACTIVE", "WITHDRAWN", "SUPERSEDED", "UNDER_REVISION"] },
            "year_published": { "type": ["integer", "null"] },
            "latest_amendment": { "type": ["string", "null"] },
            "superseded_by": { "type": ["string", "null"] },
            "supersedes": { "type": "array", "items": { "type": "string" } },
            "scope_snippet": { "type": "string" },
            "division_code": { "type": "string" },
            "ics_codes": { "type": "array", "items": { "type": "string" } },
            "confidence": { "type": "number", "minimum": 0, "maximum": 1 },
            "confidence_breakdown": {
              "type": "object",
              "properties": {
                "semantic_vector_score": { "type": "number" },
                "keyword_exact_match": { "type": "number" },
                "graph_co_citation_boost": { "type": "number" }
              }
            },
            "certification": {
              "type": "object",
              "required": ["scheme", "mandatory"],
              "properties": {
                "scheme": { "type": "string", "enum": ["BIS_ISI_MARK", "BIS_CRS", "BIS_HALLMARK", "VOLUNTARY"] },
                "mandatory": { "type": "boolean" },
                "qco_order_name": { "type": ["string", "null"] },
                "qco_gazette_ref": { "type": ["string", "null"] },
                "notifying_ministry": { "type": ["string", "null"] },
                "enforcement_date": { "type": ["string", "null"] }
              }
            }
          }
        },
        "allied_standards": {
          "type": "array",
          "items": {
            "type": "object",
            "required": ["is_number", "title", "relation_type", "status", "confidence"],
            "properties": {
              "is_number": { "type": "string" },
              "standard_id": { "type": "string" },
              "title": { "type": "string" },
              "relation_type": { "type": "string", "enum": ["TEST_METHOD", "NORMATIVE_REFERENCE", "RAW_MATERIAL_SPEC", "INSTALLATION_CODE", "DIMENSIONAL_STANDARD", "CROSS_DISCIPLINARY"] },
              "relation_label": { "type": "string" },
              "status": { "type": "string" },
              "confidence": { "type": "number" },
              "why": { "type": "string" }
            }
          }
        },
        "outdated_citations": {
          "type": "array",
          "items": {
            "type": "object",
            "required": ["cited_standard", "severity", "status", "reason", "replacement", "message"],
            "properties": {
              "cited_standard": { "type": "string" },
              "severity": { "type": "string", "enum": ["CRITICAL", "HIGH", "MEDIUM", "LOW"] },
              "status": { "type": "string" },
              "reason": { "type": "string" },
              "replacement": { "type": ["string", "null"] },
              "message": { "type": "string" }
            }
          }
        },
        "graph_path": {
          "type": "array",
          "items": {
            "type": "object",
            "required": ["from", "to", "edge_type", "label"],
            "properties": {
              "from": { "type": "string" },
              "to": { "type": "string" },
              "edge_type": { "type": "string" },
              "label": { "type": "string" }
            }
          }
        },
        "reasoning_trace": {
          "type": "array",
          "items": {
            "type": "object",
            "required": ["step", "detail", "confidence"],
            "properties": {
              "step": { "type": "string" },
              "detail": { "type": "string" },
              "confidence": { "type": "number" }
            }
          }
        },
        "plain_language_explanation": {
          "type": "object",
          "required": ["enabled", "text"],
          "properties": {
            "enabled": { "type": "boolean" },
            "text": { "type": "string" }
          }
        },
        "compliance_checklist": {
          "type": "array",
          "items": {
            "type": "object",
            "required": ["item", "status", "action_required"],
            "properties": {
              "item": { "type": "string" },
              "status": { "type": "string", "enum": ["PASS", "FAIL", "WARNING", "NOT_CHECKED"] },
              "action_required": { "type": "string" }
            }
          }
        },
        "audit_record": {
          "type": "object",
          "required": ["recommendation_id", "query_id", "timestamp", "standards_version_snapshot", "audit_hash", "logged", "dry_run", "rti_exportable"],
          "properties": {
            "recommendation_id": { "type": "string" },
            "query_id": { "type": "string" },
            "timestamp": { "type": "string", "format": "date-time" },
            "standards_version_snapshot": { "type": "object" },
            "audit_hash": { "type": "string" },
            "logged": { "type": "boolean" },
            "dry_run": { "type": "boolean" },
            "rti_exportable": { "type": "boolean" }
          }
        },
        "staleness_risk": {
          "type": "object",
          "required": ["risk_level", "standards_under_revision"],
          "properties": {
            "risk_level": { "type": "string", "enum": ["NONE", "LOW", "MEDIUM", "HIGH", "CRITICAL"] },
            "message": { "type": ["string", "null"] },
            "standards_under_revision": { "type": "array", "items": { "type": "string" } }
          }
        },
        "multilingual": {
          "type": "object",
          "required": ["bhashini_used", "detected_input_language", "response_language", "available_translations"],
          "properties": {
            "bhashini_used": { "type": "boolean" },
            "detected_input_language": { "type": "string" },
            "response_language": { "type": "string" },
            "available_translations": { "type": "array", "items": { "type": "string" } }
          }
        }
      }
    },
    "FeedbackRequest": {
      "$id": "SIH2026.FeedbackRequest.v1",
      "type": "object",
      "required": ["feedback_id", "timestamp", "original_query_id", "original_recommendation_id", "submitter", "feedback_type", "flagged_is_number", "verification_status"],
      "properties": {
        "feedback_id": { "type": "string" },
        "timestamp": { "type": "string", "format": "date-time" },
        "original_query_id": { "type": "string" },
        "original_recommendation_id": { "type": "string" },
        "submitter": {
          "type": "object",
          "required": ["user_id", "role"],
          "properties": {
            "user_id": { "type": "string" },
            "role": { "type": "string", "enum": ["PROCUREMENT_OFFICER", "AUDITOR", "BIS_EXPERT"] },
            "ministry_code": { "type": "string" }
          }
        },
        "feedback_type": { "type": "string", "enum": ["WRONG_STANDARD", "OUTDATED_STANDARD", "MISSING_ALLIED_STANDARD", "WRONG_CERTIFICATION", "FALSE_OUTDATED_FLAG", "OTHER"] },
        "flagged_is_number": { "type": "string" },
        "correct_is_number": { "type": "string" },
        "officer_notes": { "type": "string" },
        "verified": { "type": "boolean" },
        "verification_status": { "type": "string", "enum": ["PENDING", "VERIFIED_CORRECT", "VERIFIED_INCORRECT", "ESCALATED"] }
      }
    },
    "AlertPayload": {
      "$id": "SIH2026.AlertPayload.v1",
      "type": "object",
      "required": ["alert_id", "timestamp", "alert_type", "severity", "affected_standard", "affected_tenders", "recommended_action"],
      "properties": {
        "alert_id": { "type": "string" },
        "timestamp": { "type": "string", "format": "date-time" },
        "alert_type": { "type": "string", "enum": ["STANDARD_SUPERSEDED", "STANDARD_AMENDED", "STANDARD_WITHDRAWN", "QCO_ENFORCEMENT_DATE", "NEW_MANDATORY_STANDARD"] },
        "severity": { "type": "string", "enum": ["CRITICAL", "HIGH", "MEDIUM", "LOW"] },
        "affected_standard": {
          "type": "object",
          "required": ["is_number", "event"],
          "properties": {
            "is_number": { "type": "string" },
            "event": { "type": "string" },
            "replacement": { "type": ["string", "null"] }
          }
        },
        "affected_tenders": {
          "type": "array",
          "items": {
            "type": "object",
            "required": ["tender_id", "ministry", "officer_user_id", "cited_version"],
            "properties": {
              "tender_id": { "type": "string" },
              "ministry": { "type": "string" },
              "officer_user_id": { "type": "string" },
              "cited_version": { "type": "string" }
            }
          }
        },
        "recommended_action": { "type": "string" },
        "deadline": { "type": ["string", "null"] }
      }
    }
  },
  "oneOf": [
    { "$ref": "#/definitions/QueryRequest" },
    { "$ref": "#/definitions/StandardsResponse" },
    { "$ref": "#/definitions/FeedbackRequest" },
    { "$ref": "#/definitions/AlertPayload" }
  ]
}
